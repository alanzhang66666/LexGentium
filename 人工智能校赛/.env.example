# Optional server-side only; leave unset for source-grounded structured demo
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
# PORT=8080

# Required for live LLM requests (exact hostname, comma-separated)
# LLM_ALLOWED_HOSTS=api.example.com
# Max requests across the Node process per UTC calendar day (demo only)
LLM_MAX_DAILY_REQUESTS=60
