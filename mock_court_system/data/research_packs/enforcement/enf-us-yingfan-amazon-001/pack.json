  "rules": [
    {
      "rule_id": "faa-9usc-9",
      "rule_version": "faa",
      "title": "FAA 9 U.S.C. § 9（确认）",
      "text": "法院在讨论确认义务时引用：court must grant motion to confirm unless the award is vacated, modified, or corrected。本卡只收录条号，不预判本案结果。",
      "source": "9 U.S.C. § 9, as quoted in the SDNY opinion",
      "applicability_conditions": [
        "向有管辖权的美国法院申请确认仲裁裁决"
      ],
      "controversies": [
        "已履行裁决后确认请求是否仍有 standing"
      ],
      "usage_boundary": "不得把本仿真写成纽约公约承认程序；本案未适用 nyc-v-1-b。",
      "source_ids": [
        "001:p12-faa9"
      ],
      "source_tier": "historical",
      "review_state": "pending",
      "notes": ""
    },
    {
      "rule_id": "faa-9usc-10a3",
      "rule_version": "faa",
      "title": "FAA 9 U.S.C. § 10(a)(3)（misconduct）",
      "text": "where the arbitrators were guilty of misconduct in refusing to postpone the hearing, upon sufficient cause shown, or in refusing to hear evidence pertinent and material to the controversy.",
      "source": "9 U.S.C. § 10(a)(3)",
      "applicability_conditions": [
        "以拒绝延期或拒绝听取关键证据申请撤销"
      ],
      "controversies": [
        "迟到改期请求与书面补充机会是否仍构成根本不公"
      ],
      "usage_boundary": "不得把法院驳回写成对仲裁实体对错的评价。",
      "source_ids": [
        "001:p14-10a",
        "001:p16-10a3"
      ],
      "source_tier": "historical",
      "review_state": "pending",
      "notes": ""
    },
    {
      "rule_id": "faa-9usc-11a",
      "rule_version": "faa",
      "title": "FAA 9 U.S.C. § 11(a)（明显误算）",
      "text": "there was an evident material miscalculation of figures or an evident material mistake in the description of any person, thing, or property referred to in the award.",
      "source": "9 U.S.C. § 11(a)",
      "applicability_conditions": [
        "以表面上的数字误算申请修改"
      ],
      "controversies": [
        "合同解释与利润方法是否属于误算"
      ],
      "usage_boundary": "本包不把实体解释争点改写成已证明的算术错误。",
      "source_ids": [
        "001:p14-11a",
        "001:p30-not-math"
      ],
      "source_tier": "historical",
      "review_state": "pending",
      "notes": ""
    },
    {
      "rule_id": "stafford-v-ibm",
      "rule_version": "2d-cir-2023",
      "title": "Stafford v. IBM（已履行则无确认 standing）",
      "text": "Article III’s case-or-controversy requirement applies to actions governed by the FAA. A party lacks standing to seek confirmation of an award that has already been satisfied in full.",
      "source": "Stafford v. Int’l Bus. Machs. Corp., 78 F.4th 62 (2d Cir. 2023)",
      "applicability_conditions": [
        "确认之诉；裁决据称已全额履行"
      ],
      "controversies": [
        "同时提出撤销请求能否维持确认 standing"
      ],
      "usage_boundary": "不得把因 standing 驳回确认写成已拒绝承认或已确认。",
      "source_ids": [
        "001:p12-stafford",
        "001:p13-all-fours"
      ],
      "source_tier": "historical",
      "review_state": "pending",
      "notes": ""
    }
