      "item_id": "enf-claim-applicant",
      "party": "applicant",
      "claim_text": "请求部分确认责任认定（BSA §2、§3、§8 不可执行），并依 FAA 9 U.S.C. §§ 10、11 以仲裁员 misconduct、明显漠视法律及误算为由，部分撤销或修改损害赔偿。",
      "facts": "申请人主张被拒绝延期 2025-05-20 听证，未能出示损害赔偿证据、盘问证人；主张利息、费用与金额计算有误。Partial Final Award / Final Award / 邮件原件未附。",
      "norms": "FAA 9 U.S.C. §§ 10、10(a)(3)、11(a)。本包不回填纽约公约 V(1)(b)。",
      "reasoning": "拒绝延期构成 §10(a)(3) misconduct；利息与费用构成明显漠视法律；扣除与利润方法构成 §11(a) 明显重大误算。"
    },
    {
      "source_ids": [
        "001:p11-standing-arg",
        "001:p11-paid"
      ],
      "source_tier": "historical",
      "review_state": "pending",
      "notes": "",
      "revisions": [],
      "speaker": "respondent",
      "speech_type": "party_claim",
      "support_status": "indirect",
      "disclosure_status": "disputed",
      "missing_code": null,
      "conflict_values": [],
      "original_ref": null,
      "item_id": "enf-claim-respondent",
      "party": "respondent",
      "claim_text": "反对确认：裁决已按 Final Award 支付 248,844.39 美元，申请人缺乏 standing。反对修改或撤销：不构成 misconduct、明显漠视法律或明显重大误算。",
      "facts": "判决转述亚马逊支付 248,844.39 美元，申请人于 2025-08-22 确认收到。支付明细未附。",
      "norms": "Article III standing；Stafford；FAA §§ 10、11。",
      "reasoning": "已全额履行则确认请求不再构成活争议；听证多次通知且申请人未用补充书面机会。"
    }
  ],
