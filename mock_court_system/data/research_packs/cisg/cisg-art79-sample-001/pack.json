  "rules": [
    {
      "rule_id": "cisg-79",
      "rule_version": "1980-un-official",
      "title": "CISG 第七十九条",
      "text": "因不能控制的障碍免责，附通知义务；免责期间以障碍存续为限；不排除损害赔偿以外的其他权利。",
      "source": "United Nations Convention on Contracts for the International Sale of Goods (1980)",
      "applicability_conditions": [
        "公约适用的国际货物销售合同",
        "主张免责的一方对障碍各要素负举证责任"
      ],
      "controversies": [
        "经济艰难或监管风险是否构成障碍",
        "订约时对出口管制变化的可预见程度"
      ],
      "usage_boundary": "本条不自动消灭对方解除、减价等非损害赔偿权利。独立于承认执行任务，勿并入 enforcement 数据集。",
      "source_ids": [
        "001:zh-1",
        "001:zh-4",
        "001:zh-5",
        "001:en-1"
      ],
      "source_tier": "historical",
