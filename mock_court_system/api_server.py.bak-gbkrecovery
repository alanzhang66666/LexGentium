def _utcnow_iso() -> str:
    return datetime.utcnow().replace(microsecond=0).isoformat() + "Z"


def _make_request_id() -> str:
    raw = f"{uuid.uuid4()}-{datetime.utcnow().isoformat()}".encode("utf-8")
    return hashlib.sha256(raw).hexdigest()[:16]


