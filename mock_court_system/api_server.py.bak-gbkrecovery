def _determine_auto_roles(scenario: str, auto_reply_roles: Optional[List[str]]) -> List[str]:
    """Documentation."""
    if auto_reply_roles:
        return auto_reply_roles
    if scenario in ("CD", "DD"):
        return ["Client"]
    elif scenario == "CI":
        return ["Plaintiff", "Defendant"]
    return ["Client"]


