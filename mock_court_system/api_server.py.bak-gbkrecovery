@app.post("/conversation/{session_id}/auto-advance", response_model=AutoAdvanceResponse)
async def auto_advance_conversation(session_id: str, req: AutoAdvanceRequest):
    """Documentation."""
    # Auto-advance conversation by alternating agent turns.
    # Stops when max_rounds is reached or the session is finished.
    #
    try:
        record = conversation_store.get(session_id)
        if not record:
            raise HTTPException(status_code=404, detail="error")

        scenario = record.scenario
        case_id = record.case_id
        dialog_history = list(record.dialog_history)
        input_json = record.input_json
        auto_roles = _determine_auto_roles(scenario, req.auto_reply_roles)

        rounds_played = 0
        is_finished = False

        for _ in range(req.max_rounds):
            # --- Step A: 濞?Agent 闁汇垻鍠愰崹姘跺炊閻?---
            response_role, response_text, finished = run_agent_turn(
                scenario=scenario,
                case_id=case_id,
                dialog_history=dialog_history,
                input_json=input_json,
            )

            turn = len(dialog_history)
            dialog_history.append({
                "turn": turn,
                "role": response_role,
                "message": response_text,
            })
            rounds_played += 1

            if finished:
                is_finished = True
                break

            # --- Step B: SimAgent 婵☆垪鍓濈€氭瑧鈧絻顫夐弻鐔烘喆閹烘洖顥忛柛銉у仜 ---
            meta = _infer_conversation_meta(scenario, dialog_history)
            sim_role = meta.get("next_speaker")
            if not sim_role or sim_role not in auto_roles:
                break

            sim_text = await asyncio.to_thread(
                sim_agent.simulate_role,
                sim_role,
                dialog_history,
                input_json,
                scenario,
            )

            turn = len(dialog_history)
            dialog_history.append({
                "turn": turn,
                "role": sim_role,
                "message": sim_text,
            })

        record.dialog_history = dialog_history
        conversation_store.save(record)

        final_meta = _infer_conversation_meta(scenario, dialog_history)

        return AutoAdvanceResponse(
            session_id=session_id,
            rounds_played=rounds_played,
            dialog_history=dialog_history,
            is_finished=final_meta["is_finished"],
            current_stage=final_meta["current_stage"],
            next_speaker=final_meta["next_speaker"],
            available_actions=final_meta["available_actions"],
        )
    except HTTPException:
        raise
    except Exception as e:
        eval_logger.error(f"闁煎嘲袟闁规亽鍔忕换妯诲緞鏉堫偉袝: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"闁煎嘲袟闁规亽鍔忕换妯诲緞鏉堫偉袝: {str(e)}")

