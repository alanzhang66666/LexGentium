@app.post("/case/full-simulation/stream")
async def stream_full_simulation(request: FullSimulationRequest):
    """Documentation."""
    event_queue: queue.Queue = queue.Queue()

    def on_progress(stage, round_idx, role, finished):
        event_queue.put(_sse_event("stage_transition", {"stage": stage, "round": round_idx, "role": role, "finished": finished}))

    def run_simulation():
        try:
            event_queue.put(_sse_event("simulation_start", {"mode": request.mode, "case_info_keys": list(request.case_info.keys())}))
            if request.mode == "tournament":
                result = _game_engine.run_tournament(request.case_info, rounds=request.tournament_rounds, on_progress=on_progress)
            else:
                result = _orchestrator.run_full_case(request.case_info, on_progress=on_progress)
            event_queue.put(_sse_event("simulation_complete", {"result": result.to_dict()}))
        except Exception as e:
            event_queue.put(_sse_event("error", {"message": str(e)}))
        finally:
            event_queue.put(None)

    thread = threading.Thread(target=run_simulation, daemon=True)
    thread.start()

    async def event_generator():
        while True:
            try:
                event = await asyncio.to_thread(event_queue.get, timeout=300)
            except Exception:
                yield _sse_event("error", {"message": "timeout"})
                break
            if event is None:
                break
            yield event

    return StreamingResponse(
        event_generator(),
        media_type="text/event-stream",
        headers={"Cache-Control": "no-cache", "Connection": "keep-alive", "X-Accel-Buffering": "no"},
    )

