def _infer_conversation_meta(scenario: str, dialog_history: List[Dict[str, Any]]) -> Dict[str, Any]:
    """Documentation."""
    is_finished = False
    if dialog_history:
        last_role = dialog_history[-1].get("role", "")
        last_msg = dialog_history[-1].get("message", "")
        if last_role == "Final":
            is_finished = True
        elif scenario == "CD":
            clean = last_msg.strip().replace("*", "").replace("#", "").replace(" ", "")
            if clean.startswith("民事起诉状") or clean.startswith("姘戜簨璧疯瘔"):
                is_finished = True
        elif scenario == "DD":
            clean = last_msg.strip().replace("*", "").replace("#", "").replace(" ", "")
            if clean.startswith("民事答辩状") or clean.startswith("姘戜簨绛旇京"):
                is_finished = True
        elif scenario == "CI":
            try:
                exported = ci_agent.state_machine.export_state()
                if exported.get("is_finished"):
                    is_finished = True
            except Exception:
                pass
            if not is_finished and (last_msg.strip().startswith("案号") or last_msg.strip().startswith("妗堝彿") or "判决结果" in last_msg):
                is_finished = True

    current_stage = None
    next_speaker = None
    available_actions: List[str] = []

    if is_finished:
        available_actions = ["export", "delete"]
        return {
            "current_stage": "finished",
            "next_speaker": None,
            "available_actions": available_actions,
            "is_finished": True,
            "turn_count": len(dialog_history),
        }

    current_sub_stage = None

    if scenario in ("CD", "DD"):
        current_stage = "dialogue"
        last_role = dialog_history[-1]["role"] if dialog_history else None
        if last_role in ("Lawyer", None):
            next_speaker = "Client"
        else:
            next_speaker = "Lawyer"
        available_actions = ["send_message", "auto_advance"]
    elif scenario == "CI":
        current_stage = _guess_ci_stage(dialog_history)
        last_role = dialog_history[-1]["role"] if dialog_history else None
        if last_role == "Judge":
            next_speaker = "Plaintiff"
        elif last_role == "Plaintiff":
            next_speaker = "Defendant"
        else:
            next_speaker = "Judge"
        available_actions = ["send_message", "auto_advance"]
        try:
            current_sub_stage = ci_agent.state_machine.current_sub_stage.value
        except Exception:
            pass

    return {
        "current_stage": current_stage,
        "current_sub_stage": current_sub_stage,
        "next_speaker": next_speaker,
        "available_actions": available_actions,
        "is_finished": is_finished,
        "turn_count": len(dialog_history),
    }


def _guess_ci_stage(dialog_history: List[Dict[str, Any]]) -> str:
    """Documentation."""
    try:
        exported = ci_agent.state_machine.export_state()
        return exported.get("stage_label", "opening")
    except Exception:
        pass
    text_blob = " ".join(item.get("message", "") for item in dialog_history[-20:])
    if any(k in text_blob for k in ["判决", "裁定", "案号", "判决结果", "鍒ゅ喅", "妗堝彿"]):
        return "judgment"
    if any(k in text_blob for k in ["璋冭В", "鍜岃В", "鍙屾柟鏄惁鎰挎剰"]):
        return "mediation"
    if any(k in text_blob for k in ["辩论", "最后陈述", "杈╄", "鏈鍚庨檲杩"]):
        return "debate"
    if any(k in text_blob for k in ["涓捐瘉", "璐ㄨ瘉", "璇佹嵁", "璇夎璇锋眰", "闄堣堪"]):
        return "investigation"
    return "opening"


