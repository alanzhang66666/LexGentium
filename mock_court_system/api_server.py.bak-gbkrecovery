def run_agent_turn(*, scenario: str, case_id: str, dialog_history: List[Dict[str, Any]], input_json: Optional[Dict[str, Any]]):
    """Documentation."""
    response_text = ""
    is_finished = False
    response_role = "Lawyer"  # default for CD/DD

    if scenario == "CD":
        response_text = cd_agent.process_turn(dialog_history, case_id, input_json)
        clean_start = response_text.strip().replace("*", "").replace("#", "").replace(" ", "")
        if clean_start.startswith("民事起诉状") or clean_start.startswith("姘戜簨璧疯瘔"):
            is_finished = True
            response_role = "Final"
        else:
            response_role = "Lawyer"
    elif scenario == "DD":
        response_text = dd_agent.process_turn(dialog_history, case_id, input_json)
        clean_start = response_text.strip().replace("*", "").replace("#", "").replace(" ", "")
        if clean_start.startswith("民事答辩状") or clean_start.startswith("姘戜簨绛旇京"):
            is_finished = True
            response_role = "Final"
        else:
            response_role = "Lawyer"
    elif scenario == "CI":
        response_text = ci_agent.process_turn(dialog_history, case_id, input_json)
        finished_via_sm = False
        try:
            finished_via_sm = ci_agent.state_machine.export_state().get("is_finished", False)
        except Exception:
            pass
        if finished_via_sm or response_text.strip().startswith("案号") or response_text.strip().startswith("妗堝彿") or "判决结果" in response_text:
            is_finished = True
            response_role = "Final"
        else:
            response_role = "Judge"
    else:
        raise HTTPException(status_code=400, detail=f"Unknown scenario: {scenario}")

    return response_role, response_text, is_finished

