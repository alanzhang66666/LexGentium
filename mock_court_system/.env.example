# FastAPI backend URL used by Next.js server-side API routes.
BACKEND_URL=http://localhost:8000

# Browser-visible backend URL for links such as Swagger docs.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# OpenAI-compatible LLM configuration.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_THINKING=enabled
LLM_REASONING_EFFORT=high
LLM_FAST_THINKING=disabled
LLM_FAST_REASONING_EFFORT=low
# 1 = no-network product demo; serves preset content and simulated DeepSeek responses.
LLM_DEMO_MODE=0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# DashScope is used by the law retriever for embeddings/reranking.
# If unset, the retriever falls back to LLM_API_KEY where compatible.
DASHSCOPE_API_KEY=

# Conversation persistence.
CONVERSATION_STORE=sqlite
CONVERSATION_DB_PATH=./data/conversations.sqlite3

# Optional remote court simulator settings (only used by main.py batch path;
# the web service does NOT depend on it). Fill in your own endpoint.
COURT_API_BASE_URL=
COURT_API_KEY=

# Backend bind/auth: API_HOST defaults to 127.0.0.1. Set API_HOST=0.0.0.0 only
# for LAN access, and strongly prefer setting API_TOKEN then (all endpoints
# except /health will require "Authorization: Bearer <API_TOKEN>").
#API_HOST=127.0.0.1
#API_PORT=8000
#API_TOKEN=
SCENARIO_PREFIX=
TEAM_ID=
LOG_LEVEL=INFO

# Hearing / plead runtimes (default on). Set to 0 to fall back to full process_turn.
CI_USE_GRAPH=1
PLEAD_USE_RUNTIME=1
# Set to 1 to keep multiple in-turn analysis LLM calls (slower).
CI_LEGACY_ANALYSIS=0

# SQLite prompt cache for clerk/extract/score when temperature<=0.1. Set 0 to disable.
LLM_CACHE=1
# Smaller / flash model for clerk, extract, and score. Unset = same as LLM_MODEL.
#LLM_FAST_MODEL=deepseek-flash
# Token cap for those fast JSON calls only. Judgment / chat keep LLM_MAX_TOKENS.
LLM_FAST_MAX_TOKENS=512
# Auto full-case CI loop cap (interactive live turns are unchanged).
CI_MAX_AUTO_TURNS=30
