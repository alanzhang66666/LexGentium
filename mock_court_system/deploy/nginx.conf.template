# LexGentium reverse proxy template — external-reachable deployments only.
# Requirements: TLS termination, trusted proxy addresses, forwarded-header
# policy, and API_TOKEN configured on the backend before any non-loopback
# bind. Replace <example.com> and certificate paths per environment.

upstream lexgentium_web {
    server 127.0.0.1:3000;
}

server {
    listen 80;
    server_name <example.com>;
    # Redirect everything to TLS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name <example.com>;

    ssl_certificate     /etc/lexgentium/tls/fullchain.pem;
    ssl_certificate_key /etc/lexgentium/tls/privkey.pem;

    # Forwarded-header policy: only this proxy may set them; the backend
    # treats anything else as untrusted.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # SSE streams must not be buffered or idle-timed-out by the proxy.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 3600s;

    # Browser traffic is same-origin only: all business calls go through the
    # Next BFF, which attaches server-side credentials itself.
    location / {
        proxy_pass http://lexgentium_web;
    }
}
