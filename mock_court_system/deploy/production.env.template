# Production environment template — copy to .env and fill values locally.
# Never commit a filled .env. Placeholders only; no real secrets here.

# --- Required LLM configuration ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Backend bind ---
# Loopback-only behind a proxy: 127.0.0.1. Non-loopback REQUIRES API_TOKEN.
API_HOST=127.0.0.1
API_PORT=8000

# --- Authentication ---
# Required when API_HOST is not loopback; BFF reads BACKEND_API_TOKEN or
# API_TOKEN from server environment only — never from the browser.
API_TOKEN=
BACKEND_API_TOKEN=

# --- BFF ---
BACKEND_URL=http://127.0.0.1:8000
BFF_MAX_BODY_BYTES=1048576

# --- Origin allowlist (comma-separated; browser state-changing requests) ---
API_ALLOWED_ORIGINS=https://<example.com>

# --- Optional tuning (defaults are release-declared) ---
# LLM_FAST_MAX_TOKENS=512
# CI_MAX_AUTO_TURNS=30
# API_MAX_BODY_BYTES=1048576
